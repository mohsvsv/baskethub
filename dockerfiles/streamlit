FROM python:3.12-slim

WORKDIR /app

# install requirements
COPY core/requirements.txt ./requirements/core.txt
COPY app/requirements.txt ./requirements/app.txt
RUN pip install --no-cache-dir -r ./requirements/core.txt
RUN pip install --no-cache-dir -r ./requirements/app.txt

# copy files
COPY scripts/init-app.sh ./
COPY app/app.py ./

RUN chmod +x /app/init-app.sh

# generate secrets.toml file and run streamlit app
CMD ["sh", "-c", "/app/init-app.sh && exec streamlit run /app/app.py --server.port=8501 --server.address=0.0.0.0"]